#include <iostream>
#include <concepts>

template <typename T>
concept WithReadablePos2D = requires {
    {std::declval<T>().get_pos_x()}->std::convertible_to<float>;
    {std::declval<T>().get_pos_y()}->std::convertible_to<float>;
};

template <typename T>
concept WithReadablePos3D = WithReadablePos2D<T> &&
requires {
    {std::declval<T>().get_pos_z() }->std::convertible_to<float>;
};

template <typename T>
concept WithWriteablePos2D = requires {
    {std::declval<T>().set_pos_x(std::declval<float>())}->std::convertible_to<void>;
    {std::declval<T>().set_pos_x(std::declval<float>())}->std::convertible_to<void>;
};

template <typename T>
concept WithWriteablePos3D = WithWriteablePos2D<T> &&
requires {
    {std::declval<T>().set_pos_z(std::declval<float>())}->std::convertible_to<void>;
};

template <typename T>
concept WithReadableDirection = requires {
    {std::declval<T>().get_yaw()}->std::convertible_to<float>;
    {std::declval<T>().get_pitch()}->std::convertible_to<float>;
    {std::declval<T>().get_roll()}->std::convertible_to<float>;
};

template <typename T>
concept WithWriteableDirection = requires {
    {std::declval<T>().set_yaw(std::declval<float>())}->std::convertible_to<void>;
    {std::declval<T>().set_pitch(std::declval<float>())}->std::convertible_to<void>;
    {std::declval<T>().set_roll(std::declval<float>())}->std::convertible_to<void>;
};

template <typename Derived>
requires WithReadablePos3D<Derived> && WithReadableDirection<Derived>
struct Movable3D {
    void move_forward(float dt,float step) {
        auto* self = static_cast<Derived>(this);
