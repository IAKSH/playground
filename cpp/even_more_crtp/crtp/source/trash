template <typename Derived>
struct NonCopyable {
protected:
    NonCopyable() = default;
    ~NonCopyable() = default;
    NonCopyable(const NonCopyable&) = delete;
    NonCopyable& operator=(const NonCopyable&) = delete;
};

template <typename T>
concept WithHealthPoint = requires {
    {std::declval<T>().health_point}->std::convertible_to<float>;
};

class GameObject : Movable3D<GameObject> {
private:
    float pos_x = 0;
    float pos_y = 0;

public:
    float get_pos_x() {
        return pos_x;
    }

    float get_pos_y() {
        return pos_y;
    }
};

class Stone : public GameObject {

};

class Wolf : public GameObject {
    static_assert(WithHealthPoint<Wolf>);
public:
    float health_point = 100.0f;
};

